+const attention=(r)=>r.classification==="fuzzy"||r.classification==="not_found"||r.pinpoint?.status==="mismatch";
+
+/* ===== render ===== */
+function renderCounts(){const s=report.summary;
+  $('counts').innerHTML=`<div><b>${s.total}</b><span>quotes checked</span></div><div><b>${s.checked} of ${s.total}</b><span>located</span></div><div><b>${s.exact}</b><span>exact</span></div><div><b>${s.normalized}</b><span>normalized</span></div><div><b>${s.fuzzy}</b><span>fuzzy</span></div><div><b>${s.not_found}</b><span>not found</span></div><div><b>${s.pinpointIssues}</b><span>pinpoint issues</span></div>`;
+  let c=`Checked ${s.checked} of ${s.total} quotes — ${s.couldNotCheck} could not be checked and are never reported as "confirmed"; ${s.unparseablePinpoints} unparseable pinpoint(s).`;
+  if(report.extractionWarnings?.length)c+=" "+report.extractionWarnings.join("; ")+".";
+  $('coverage').textContent=c}
+
+function renderTable(){
+  $('results').innerHTML=`<tr><th scope="col">Quote</th><th scope="col">Verdict</th><th scope="col">Similarity</th><th scope="col">Anchor</th><th scope="col">Pinpoint</th><th scope="col">Review</th></tr>`+
+  report.results.map((r)=>{const a=r.anchor??r.bestCandidate;
+    const anchor=a?`<button class="anchor-btn">${esc(a.sourceName)}${a.segmentLabel!==null?`, ${KIND[a.segmentKind]??esc(a.segmentKind)} ${esc(a.segmentLabel)}`:""} <code>${a.charStart}–${a.charEnd}</code> ↗</button>`:"—";
+    const pin=r.pinpoint?`<span class="pill ${r.pinpoint.status==="mismatch"?"mismatch":r.pinpoint.status==="ok"?"exact":""}">${esc(r.pinpoint.status)}</span> ${esc(r.pinpoint.raw)}`:"—";
+    const d=decisions[r.id];
+    return `<tr class="${selected===r.id?"sel":""} ${attention(r)?"attention":""} ${d?"flag":""}" data-q="${esc(r.id)}"><td class="mono"><code>${esc(r.id)}</code></td><td><span class="pill ${r.classification}">${r.classification}</span></td><td class="mono">${r.similarity.toFixed(2)}</td><td>${anchor}</td><td>${pin}</td><td>${d?`<span class="pill st-${d.d}">${d.d}</span>`:'<span class="pill">pending</span>'}</td></tr>`}).join("");
+  for(const tr of $('results').querySelectorAll('tr[data-q]'))tr.addEventListener("click",()=>selectQuote(tr.dataset.q,true))}
+
+function renderQueue(){
+  const rs=report.results.filter((r)=>{const d=decisions[r.id];
+    if(filter==="attention")return attention(r);
+    if(filter==="undecided")return !d;
+    if(filter==="flagged")return d?.d==="flagged";
+    return true});
+  $('briefSub').textContent=`${rs.length} of ${report.results.length} quotations shown — filter: ${filter}`;
+  $('queue').innerHTML=rs.map((r)=>{const a=r.anchor??r.bestCandidate;const d=decisions[r.id];
+    return `<article class="q ${selected===r.id?"sel":""}" data-q="${esc(r.id)}"><header><code class="mono">${esc(r.id)}</code> <span class="pill ${r.classification}">${r.classification}</span> ${d?`<span class="pill st-${d.d}">${d.d}</span>`:'<span class="pill">pending</span>'}</header><blockquote>${esc(r.text)}</blockquote>`+
+    (r.proposition?`<p class="prop">Proposition: ${esc(r.proposition)}</p>`:"")+
+    `<div class="meta">Anchor: ${a?`<button class="anchor-btn" data-anchor="${esc(r.id)}">${esc(a.sourceName)}${a.segmentLabel!==null?`, ${KIND[a.segmentKind]??esc(a.segmentKind)} ${esc(a.segmentLabel)}`:""} <code>${a.charStart}–${a.charEnd}</code> ↗</button>`:"no locating anchor in the provided sources"}`+
+    (r.pinpoint?`<br>Pinpoint <code>${esc(r.pinpoint.raw)}</code> → <b>${esc(r.pinpoint.status)}</b>: ${esc(r.pinpoint.detail)}`:"")+
+    (r.diff&&formatDiffOps(r.diff)?`<br>Token diff: <code>${esc(formatDiffOps(r.diff))}</code>`:"")+
+    r.notes.map((n)=>`<br>· ${esc(n)}`).join("")+`</div>`+
+    `<div class="decide" role="group" aria-label="Decision for ${esc(r.id)}">${DECISIONS.map(([v,l])=>`<button data-d="${v}" data-q="${esc(r.id)}" aria-pressed="${d?.d===v?"true":"false"}">${l}</button>`).join("")}</div>`+
+    `<div class="note"><label for="note-${esc(r.id)}">Note</label><input id="note-${esc(r.id)}" data-note="${esc(r.id)}" value="${esc(d?.note??"")}" placeholder="optional"></div></article>`}).join("")||`<p class="hint">No quotations match this filter.</p>`;
+  for(const b of $('queue').querySelectorAll('button[data-d]'))b.addEventListener("click",(e)=>{e.stopPropagation();setDecision(b.dataset.q,b.dataset.d)});
+  for(const b of $('queue').querySelectorAll('button[data-anchor]'))b.addEventListener("click",(e)=>{e.stopPropagation();selectQuote(b.dataset.anchor,false)});
+  for(const i of $('queue').querySelectorAll('input[data-note]'))i.addEventListener("change",()=>setNote(i.dataset.note,i.value));
+  for(const art of $('queue').querySelectorAll('article.q'))art.addEventListener("click",()=>selectQuote(art.dataset.q,false))}
+
+function renderSourcePane(){
+  const ms=models(),sel=$('srcSel'),ids=[...ms.keys()];
+  const cur=sel.dataset.src&&ms.has(sel.dataset.src)?sel.dataset.src:(ids[0]??null);
+  sel.dataset.src=cur;
+  sel.innerHTML=ids.map((id)=>`<option value="${esc(id)}" ${id===cur?"selected":""}>${esc(ms.get(id).name)}</option>`).join("");
+  let html="";
+  if(!cur)html=`<p class="hint">No sources loaded.</p>`;
+  else{const m=ms.get(cur);
+    const r=report.results.find((x)=>x.id===selected);
+    const a=r&&(r.anchor?.sourceId===cur||r.bestCandidate?.sourceId===cur)?(r.anchor??r.bestCandidate):null;
+    for(const seg of m.segments){let text=esc(seg.text);
+      if(a&&a.charEnd>seg.start&&a.charStart<seg.end){
+        const s=Math.max(a.charStart,seg.start)-seg.start,e=Math.min(a.charEnd,seg.end)-seg.start;
+        const idAt=(a.charStart>=seg.start&&a.charEnd<=seg.end)?' id="hl"':"";
+        text=esc(seg.text.slice(0,s))+`<mark${idAt}>${esc(seg.text.slice(s,e))}</mark>`+esc(seg.text.slice(e))}
+      html+=`<div class="seg"><h4>${seg.kind?`${KIND[seg.kind]??esc(seg.kind)} ${esc(seg.label)}`:"Full text"}</h4><p>${text}</p></div>`}}
+  $('srcview').innerHTML=html;
+  const mark=$('hl');if(mark)mark.scrollIntoView({block:"center"})}
+
+function renderProgress(){
+  const total=report.results.length,done=report.results.filter((r)=>decisions[r.id]).length,flagged=report.results.filter((r)=>decisions[r.id]?.d==="flagged").length;
+  let h=`${done} of ${total} decided · ${flagged} flagged`;
+  if(signoff)h+=` · <b>signed off</b> ${esc(signoff.at.slice(0,16).replace("T"," "))} UTC`;
+  else if(done===total&&total>0)h+=` · <button class="icon" id="signBtn">Sign off review</button>`;
+  $('progress').innerHTML=h;
+  const b=$('signBtn');
+  if(b)b.addEventListener("click",()=>{signoff={at:new Date().toISOString(),actor:"reviewer (demo)",decided:report.results.length};
+    store.set('signoff',signoff);audit("sign-off",`review signed off over ${report.results.length} quotes`);
+    toast("Review signed off — recorded in the audit log.");live("Review signed off.");renderProgress()})}
+
+function renderAudit(){const es=store.entries('audit');
+  $('auditOut').innerHTML=es.length?`<div class="audit-list">${es.map((e)=>`<div>${esc(e.ts)} · ${esc(e.actor)} · ${esc(e.action)}${e.quoteId?` · ${esc(e.quoteId)}`:""} — ${esc(e.detail)}</div>`).join("")}</div>`:`<p class="hint">No entries yet — make a decision or run a check.</p>`}
+
+function renderAll(){renderCounts();renderTable();renderQueue();renderSourcePane();renderProgress()}
+
+/* ===== interactions ===== */
+function selectQuote(id,scrollBench){
+  selected=id;
