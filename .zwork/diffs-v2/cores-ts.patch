+ * @param {string[]} quote @param {string[]} source
+ * @returns {{ quoteOnly: string[], sourceOnly: string[] }} */
+export function negationDivergence(quote, source) {
+  const qNeg = multiset(quote.filter((t) => NEGATORS.has(t)));
