+  if(a)$('srcSel').dataset.src=a.sourceId;
+  renderTable();renderQueue();renderSourcePane();
+  const card=$('queue').querySelector(`article[data-q="${CSS.escape(id)}"]`);if(card)card.scrollIntoView({block:"nearest"});
+  if(scrollBench)$('bench').scrollIntoView({behavior:"smooth",block:"start"});
+  if(r)live(`Quote ${id} selected — ${r.classification}${a?`, anchor at chars ${a.charStart} to ${a.charEnd} in ${a.sourceName}`:", no anchor"}.`)}
+
+function setDecision(id,d){
+  const from=decisions[id]?.d??"pending";
