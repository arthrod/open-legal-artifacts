+    } else if (asOf) {
+      const ageDays = -Math.round((updated.getTime() - asOf.getTime()) / 86400000);
+      if (ageDays > staleDays) anomalies.push({ id, name, anomaly: "stale", detail: `updatedAt ${m.updatedAt} is ${ageDays}d before asOf` });
+    }
