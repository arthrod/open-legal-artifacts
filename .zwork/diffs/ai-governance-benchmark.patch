+  function parseCsv(s) {
+    const rows = []; let row = []; let field = ''; let inQ = false; let i = 0;
+    while (i < s.length) {
+      const ch = s[i];
+      if (inQ) {
+        if (ch === '"') { if (s[i + 1] === '"') { field += '"'; i += 2; continue; } inQ = false; i++; continue; }
