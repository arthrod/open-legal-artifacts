+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { buildPropositionPrompt, mergeVerdicts } from './propositions';
+import { runCiteCheck } from './citecheck';
+import type { CiteCheckInput } from './citecheck';
+
+const INPUT: CiteCheckInput = {
+  document: { name: 'Proposition test (fictional)' },
+  sources: [
+    {
+      id: 'depo',
+      name: 'Deposition (fictional)',
+      pages: [{ number: 12, text: 'A. Mr. Beltran signed the delivery receipt without noting any exception on the document. The delivery occurred at the loading dock in the late afternoon.' }],
+    },
+  ],
+  quotes: [
+    { id: 'Q1', text: 'Mr. Beltran signed the delivery receipt without noting any exception on the document.', sourceId: 'depo', proposition: 'Delivery accepted without exception.' },
+    { id: 'Q2', text: 'Mr. Beltran signed the delivery receipt without noting any exception on the document at the loading dock', sourceId: 'depo', proposition: 'Paraphrased version.' },
+  ],
+};
+
+test('buildPropositionPrompt includes only exact/normalized quotes and their anchors', () => {
+  const report = runCiteCheck(INPUT);
+  const prompt = buildPropositionPrompt(report);
+  assert.ok(prompt.includes('"Q1"'), prompt);
+  assert.ok(!prompt.includes('"Q2"'), prompt);
+  assert.ok(prompt.includes('signed the delivery receipt'), prompt);
+  assert.ok(prompt.includes('verbatim'), prompt);
+});
+
+test('mergeVerdicts refuses non-verbatim-verified quotes and anchor mismatches', () => {
+  const report = runCiteCheck(INPUT);
+  assert.equal(report.results[1].classification, 'fuzzy');
+  const merged = mergeVerdicts(report, [
+    { id: 'Q1', proposition: 'Delivery accepted without exception.', supported: true, reasoning: 'ok', anchorFromCore: report.results[0].anchor!.verbatim },
+    { id: 'Q2', proposition: 'Paraphrased version.', supported: true, reasoning: 'nope' },
+    { id: 'Q1', proposition: 'Delivery accepted without exception.', supported: false, reasoning: 'stale', anchorFromCore: 'something else entirely' },
+    { id: 'QX', proposition: 'unknown', supported: true, reasoning: '?' },
+  ]);
+  assert.equal(merged[0].eligible, true);
+  assert.equal(merged[0].verdict?.supported, true);
+  assert.equal(merged[1].eligible, false);
+  assert.ok(merged[1].refusal!.includes('fuzzy'), merged[1].refusal);
+  assert.equal(merged[2].eligible, false);
+  assert.ok(merged[2].refusal!.includes('anchor'), merged[2].refusal);
+  assert.equal(merged[3].eligible, false);
+  assert.ok(merged[3].refusal!.includes('no quote'), merged[3].refusal);
+});
diff --git a/open-artifacts/cite-check/core/propositions.ts b/open-artifacts/cite-check/core/propositions.ts
new file mode 100644
index 0000000..27bf55b
--- /dev/null
+++ b/open-artifacts/cite-check/core/propositions.ts
@@ -0,0 +1,75 @@
+/**
+ * Proposition harness — the auditable two-stage pipeline around the LLM part.
+ *
+ * The deterministic core classifies and anchors quotes; ONLY quotes classified
+ * exact/normalized are eligible for LLM/human proposition judgment. Everything
+ * else is refused with a note: there is no verbatim-verified anchor to judge
+ * against, and the core never lets judgment outrun verification.
+ */
+
+import type { CiteCheckReport, Classification, QuoteResult } from './citecheck';
+
+export interface PropositionVerdict {
+  id: string;
+  proposition: string;
+  supported: boolean | 'unclear';
+  reasoning: string;
+  /** the core's verbatim anchor echoed back, so the verdict is pinned to text */
+  anchorFromCore?: string;
+}
+
+export interface MergedVerdict {
+  id: string;
+  classification: Classification | null;
+  eligible: boolean;
+  verdict?: PropositionVerdict;
+  refusal?: string;
+}
+
+/** Structured prompt for the LLM/human judgment stage (never classification). */
+export function buildPropositionPrompt(report: CiteCheckReport): string {
+  const eligible = report.results.filter(
+    (r: QuoteResult) => r.classification === 'exact' || r.classification === 'normalized',
+  );
+  const items = eligible.map((r) => ({
+    id: r.id,
+    proposition: r.proposition ?? null,
+    source: r.anchor?.sourceName ?? null,
+    anchor: r.anchor?.verbatim ?? null,
+  }));
+  return [
+    'You are judging whether each verbatim-verified quotation actually supports the proposition it is offered to prove.',
+    'Quote fidelity was already verified deterministically (exact/normalized). Judge SUPPORT ONLY — never re-classify the quote text.',
+    'Respond with JSON only:',
+    '{"verdicts":[{"id":"...","supported":true|false|"unclear","reasoning":"..."}]}',
+    'Quotes to judge:',
+    JSON.stringify(items, null, 2),
+  ].join('\n');
+}
+
+/** Merge LLM/human verdicts into the report, gating on core verification. */
+export function mergeVerdicts(report: CiteCheckReport, verdicts: PropositionVerdict[]): MergedVerdict[] {
+  return verdicts.map((v) => {
+    const r = report.results.find((x) => x.id === v.id);
+    if (!r) {
+      return { id: v.id, classification: null, eligible: false, refusal: `refused: no quote with id "${v.id}" in the report` };
+    }
+    if (r.classification !== 'exact' && r.classification !== 'normalized') {
+      return {
+        id: v.id,
+        classification: r.classification,
+        eligible: false,
+        refusal: `refused: classification "${r.classification}" is not verbatim-verified — the deterministic core gates proposition judgment`,
+      };
+    }
+    if (v.anchorFromCore !== undefined && v.anchorFromCore !== r.anchor?.verbatim) {
+      return {
+        id: v.id,
+        classification: r.classification,
+        eligible: false,
+        refusal: 'refused: echoed anchor does not match the core anchor for this quote',
+      };
+    }
+    return { id: v.id, classification: r.classification, eligible: true, verdict: v };
+  });
+}
