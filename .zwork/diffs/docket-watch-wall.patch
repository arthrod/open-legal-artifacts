+    'VERSION:2.0',
+    'PRODID:-//docket-watch-wall//open-legal-artifacts//EN',
+    'CALSCALE:GREGORIAN',
+  ];
+  for (const ev of events) {
+    const end = fmtUTCDate(parseUTCDate(ev.d.date) + DAY_MS); // DTEND is exclusive
+    lines.push(
